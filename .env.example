# Bind only to loopback. Put an authenticated HTTPS proxy or tunnel in front.
CODEXPRO_BRIDGE_HOST=127.0.0.1
CODEXPRO_BRIDGE_PORT=18787

# Required unless anonymous mode is deliberately enabled for local testing.
CODEXPRO_BRIDGE_HTTP_TOKEN=<replace-with-a-random-value-of-at-least-24-bytes>

# Adapt these paths to the local Hermes installation.
CODEXPRO_BRIDGE_HERMES_HOME=/hermes/hermes_data
CODEXPRO_BRIDGE_HERMES_WORKDIR=/opt/hermes
CODEXPRO_BRIDGE_HERMES_PYTHON=/opt/hermes/.venv/bin/python
CODEXPRO_BRIDGE_MEMOS_COMMAND=<path-to-installed-memos-api-mcp>

CODEXPRO_BRIDGE_SKILL_TIMEOUT=30
CODEXPRO_BRIDGE_MCP_TIMEOUT=180
CODEXPRO_BRIDGE_MAX_OUTPUT_CHARS=120000
