[Unit]
Description=CodexPro Bridge MCP (Go 3.1.6)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/gpt-workspace/codexpro-bridge
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOMEMLIMIT=128MiB
Environment=CODEXPRO_BRIDGE_HOST=127.0.0.1
Environment=CODEXPRO_BRIDGE_PORT=18787
EnvironmentFile=-/home/agent/.config/codexpro-bridge/providers.env
EnvironmentFile=/home/agent/.config/codexpro-bridge/env
ExecStart=/home/agent/.local/bin/codexpro-bridge
Restart=always
RestartSec=3s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=default.target
